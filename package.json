{
  "name": "@senndo/sdk",
  "version": "1.2.0",
  "description": "Official TypeScript / JavaScript SDK for the senndo messaging and verification API.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "senndo",
    "sms",
    "whatsapp",
    "email",
    "voice",
    "otp",
    "messaging",
    "cpaas"
  ]
}
